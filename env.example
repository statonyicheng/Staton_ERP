#--------------------------------------------------------------------
# 仕坦登 ERP 環境設定範本
#
# 部署步驟：
#   1. 複製本檔為 .env        cp env.example .env
#   2. 填入實際的資料庫帳密與網址
#   3. .env 永遠不進版控（.gitignore 已排除）
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#   正式機一律 production；除錯時暫時改 development 看堆疊，查完改回來
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://erp.example.com/'
app.indexPage = ''
app.appTimezone = 'Asia/Taipei'
app.defaultLocale = 'zh-Hant'

# 正式機務必為 true（強制 HTTPS）；本機開發用 false
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE
#   正式機請建立專用帳號，不要用 root，並設定強密碼
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = land_stone_quote
database.default.username = staton_erp
database.default.password = 'CHANGE_ME'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SESSION / SECURITY
#   正式機（HTTPS）務必開啟 secure cookie
#--------------------------------------------------------------------
session.cookieName = staton_erp_session
session.expiration = 7200
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# LOGGING
#   4 = 只記錄錯誤（正式機建議值）
#--------------------------------------------------------------------
logger.threshold = 4
